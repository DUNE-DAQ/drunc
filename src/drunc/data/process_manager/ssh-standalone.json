{
    "type": "ssh",
    "name": "SSHProcessManager",
    "kill_timeout": 10.0,
    "settings": {
        "disable_localhost_host_key_check": true,
        "disable_host_key_check": true
    },
    "authoriser": {
        "type": "dummy"
    },
    "environment": {
        "GRPC_ENABLE_FORK_SUPPORT": "false",
        "DUNEDAQ_ERS_ERROR": "erstrace,throttle,lstdout",
        "DUNEDAQ_ERS_FATAL": "erstrace,lstdout",
        "DUNEDAQ_ERS_INFO": "erstrace,throttle,lstdout",
        "DUNEDAQ_ERS_WARNING": "erstrace,throttle,lstdout"
    },
    "opmon_uri": {
        "path": "./info.json",
        "type": "file"
    },
    "opmon_conf": {
        "level": "info",
        "interval_s": 10.0
    }
}