{
    "type": "ssh",
    "name": "SSHProcessManager",
    "kill_timeout": 0.1,
    "settings": {
        "disable_localhost_host_key_check": true,
        "disable_host_key_check": true
    },
    "authoriser": {
        "type": "dummy"
    },
    "environment": {
        "GRPC_ENABLE_FORK_SUPPORT": "false"
    },
    "opmon_uri": {
        "path": "./info.json",
        "type": "file"
    },
    "ers_uri": {
        "path": "./info.json",
        "type": "file"
    },
    "opmon_conf": {
        "level": "info",
        "interval_s": 10.0
    }
}