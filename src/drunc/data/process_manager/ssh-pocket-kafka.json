{
    "type": "ssh",
    "name": "SSHProcessManager",
    "authoriser": {
        "type": "dummy"
    },
    "broadcaster": {
        "type": "kafka",
        "kafka_address": "localhost:31014",
        "publish_timeout": 2
    },
    "environment": {
        "GRPC_ENABLE_FORK_SUPPORT": "false"
    },
    "opmon_uri": {
        "path": "monkafka.cern.ch:30092/opmon_stream",
        "type": "stream"
    },
    "opmon_conf": {
        "level": "debug",
        "interval_s": 10.0
    }
}