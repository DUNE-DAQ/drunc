{
    "type": "ssh",
    "name": "SSHProcessManager",
    "command_address": "localhost:0",
    "kill_timeout": 0.5,

    "authoriser": {
        "type": "dummy"
    },

    "broadcaster": {
        "type": "kafka",
        "kafka_address": "monkafka.cern.ch:30092",
        "publish_timeout": 2
    },
    "environment": {
        "GRPC_ENABLE_FORK_SUPPORT": "false"
    },
    "opmon_uri": {
        "path": "monkafka.cern.ch:30092/opmon_stream",
        "type": "stream"
    },
    "opmon_conf":{
        "level": "debug",
        "interval_s" : 10.0
    },
    "ers_conf":{
        "debug": "stdout",
        "log": "stdout",
        "info": "throttle,protobufstream(monkafka.cern.ch:30092)",
        "warning": "throttle,stdout,protobufstream(monkafka.cern.ch:30092)",
        "error": "throttle,stdout,protobufstream(monkafka.cern.ch:30092)",
        "fatal": "stdout,protobufstream(monkafka.cern.ch:30092)",
        "verbosity_level": 1
    }
}
